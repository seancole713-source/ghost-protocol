# secrets.env.template
# ===================
# Template for local development secrets
# 
# INSTRUCTIONS:
# 1. Copy this file: cp secrets.env.template secrets.env
# 2. Fill in your actual API keys (secrets.env is gitignored)
# 3. NEVER commit secrets.env to git
#
# PRODUCTION:
# - Use Railway environment variables instead of this file
# - Railway will ignore secrets.env even if present
# - Set vars via: railway variables set KEY=value

# Market Data Providers
POLYGON_API_KEY=your_polygon_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Ghost API Authentication
# Generate with: openssl rand -hex 32
GHOST_API_TOKEN=your_ghost_api_token_here

# Telegram Bot (optional)
# Get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your_telegram_chat_id

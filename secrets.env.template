# secrets.env.template
# ===================
# Template for local development secrets
#
# INSTRUCTIONS:
# 1. Copy this file: cp secrets.env.template secrets.env
# 2. Run `railway variables --service ghost-protocol --environment production --json`
#    and copy only the values you need into secrets.env (never commit it).
# 3. Leave secrets blank here—this template is documentation only.
#
# PRODUCTION:
# - Always rely on Railway environment variables
# - Set/rotate via: railway variables set KEY=value

# Market Data Providers (set via Railway → Variables)
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=

# Ghost API Authentication
# Generate with: openssl rand -hex 32, then store in Railway
GHOST_API_TOKEN=

# Telegram Bot (optional)
# Get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

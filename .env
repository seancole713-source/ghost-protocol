# Ghost Protocol - Local Environment Overrides
# ------------------------------------------------------------
# Copy this file to .env.local (ignored) and fill in only the
# variables you need for local debugging. The canonical values
# live in Railway → tender-benevolence → ghost-protocol → Variables.
#
# To inspect them safely:
#   railway variables --service ghost-protocol
#   railway variables get <NAME>
# Do NOT paste production secrets back into this file.

SIM_MODE=0
STOCKS_ENABLED=1
CRYPTO_ENABLED=1
PORT=8080

# Secrets intentionally blank; export from shell before running
OPENAI_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
GHOST_API_TOKEN=

# Networking
ADMIN_IP_ALLOWLIST=
ALLOWED_ORIGINS=http://127.0.0.1:8080

# Data services (local defaults only)
REDIS_URL=redis://redis:6379
STOCK_PRICE_SOURCE=polygon
CRYPTO_PRICE_SOURCE=coingecko
PRICE_STRICT_LIVE=0
PRICE_REQUIRE_QUORUM=0
PREDICT_REQUIRE_PRICE_QUORUM=0

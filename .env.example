# Ghost Protocol Environment Configuration
# Copy to .env and fill in your actual values

# ============================================================================
# CORE APPLICATION
# ============================================================================
PORT=8000
ENV=production
DEBUG=0
LOG_LEVEL=info

# ============================================================================
# PRICE PROVIDERS (Stock Market Data)
# ============================================================================

# Alpha Vantage - Free tier: 25 requests/day
# Get your key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=3WNNLA81KS7BG4AK

# Polygon.io - Free tier: 5 requests/minute, delayed data
# Get your key: https://polygon.io/dashboard/signup
POLYGON_API_KEY=8VIvELVXiLG30K2l1348RzSurffLM0jR

# Yahoo Finance - No key required (uses yfinance library)
# Fallback provider, may be rate-limited

# ============================================================================
# CRYPTO PROVIDERS (24/7 Markets)
# ============================================================================

# Enable crypto predictions (1=enabled, 0=disabled)
CRYPTO_ENABLED=1

# Crypto symbols to track (comma-separated)
CRYPTO_SYMBOLS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,MATIC,DOT,AVAX

# Provider quorum (comma-separated, tried in order)
CRYPTO_QUORUM=binance,coingecko,coinbase

# Optional API keys (all providers work without keys on free tier)
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_API_KEY=
COINBASE_API_KEY=

# ============================================================================
# BROKER INTEGRATION (Live Trading)
# ============================================================================

# Broker selection (alpaca, ibkr, robinhood)
BROKER=alpaca

# Alpaca Markets - Paper trading by default
# Get your keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_KEY_ID=PKVUMLL1V91W9Y5QCG77
ALPACA_SECRET_KEY=sw09z6TdIeXrs9G6fE5Lo9AayM44UmSWiEYcuXyk
ALPACA_PAPER=1
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2

# ============================================================================
# RISK MANAGEMENT
# ============================================================================

# Maximum position size as % of portfolio
RISK_MAX_POS_PCT=5

# Stop-loss percentage
RISK_SL_PCT=3

# Take-profit percentage
RISK_TP_PCT=6

# Maximum daily drawdown percentage
RISK_MAX_DAILY_DD_PCT=5

# Kill switch (1=trading disabled, 0=trading enabled)
RISK_KILL=0

# ============================================================================
# WOLF POSITION TRACKING
# ============================================================================

# Your WOLF position details
WOLF_QTY=8.41959051
WOLF_AVG_COST=359.28

# ============================================================================
# AI/ML SERVICES
# ============================================================================

# OpenAI API (for ChatGPT analyst features)
OPENAI_API_KEY=sk-proj-...
OPENAI_AGENT_API_KEY=sk-proj-...

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Telegram Bot (for alerts and trading notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Webhook (for operational alerts)
SLACK_WEBHOOK_URL=

# ============================================================================
# SECURITY
# ============================================================================

# Authentication secret (generate with: openssl rand -hex 32)
AUTH_SECRET=5e7a60f7b0e841e5a56f5b9f02e35c9c1d2af64b3a45f07e6c8b9a4e0d8b5b2a

# IP Allowlist (comma-separated, empty = disabled)
IP_ALLOWLIST=

# ============================================================================
# PREDICTION SYSTEM
# ============================================================================

# Auto-prediction loop interval (seconds)
PREDICTION_INTERVAL_SEC=300

# Stock symbols to track (comma-separated)
HUNTER_STOCK_SYMBOLS=WOLF,AAPL,MSFT,NVDA,TSLA,GOOGL,META,AMZN,NFLX,AMD,COIN,PLTR,SOFI,HOOD,PACS

# Crypto symbols to track (comma-separated)
HUNTER_CRYPTO_SYMBOLS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,MATIC,DOT,AVAX

# Market hours enforcement (1=respect market hours, 0=run 24/7)
RESPECT_MARKET_HOURS=1

# ============================================================================
# DATABASE
# ============================================================================

# SQLite paths (relative to project root)
DB_PATH=./data/ghost_predictions.db
AI_MEMORY_DB=./data/ai_memory.db

# ============================================================================
# EXTERNAL DATA SOURCES (Optional)
# ============================================================================

# Trading Economics API
TRADING_ECONOMICS_API_KEY=

# Federal Reserve Economic Data (FRED)
FRED_API_KEY=

# News API
NEWS_API_KEY=

# ============================================================================
# DEVELOPMENT/TESTING
# ============================================================================

# Test mode (1=use test data, 0=use real data)
TEST_MODE=0

# Dry run mode (1=no real trades, 0=real trades)
DRY_RUN=0

{
  "nodes": [
    {"id": "ui_cockpit", "type": "ui", "desc": "Cockpit dashboard HTML/JS", "deps": ["api_cockpit", "ui_prediction_panel"]},
    {"id": "api_cockpit", "type": "api", "desc": "GET /api/cockpit", "deps": ["db_portfolio", "api_predictions", "api_news", "api_macro"]},
    {"id": "ui_prediction_panel", "type": "ui", "desc": "Ghost Prediction panel (stocks|crypto)", "deps": ["api_predictions", "ui_tabs"]},
    {"id": "ui_tabs", "type": "ui", "desc": "Stocks|Crypto tabs", "deps": []},
    {"id": "api_predictions", "type": "api", "desc": "GET /api/predict/* and /api/crypto/predict/*", "deps": ["prediction_engine", "db_predictions"]},
    {"id": "prediction_engine", "type": "logic", "desc": "Forecast generation + MAP scoring", "deps": ["price_providers", "db_actuals"]},
    {"id": "price_providers", "type": "provider", "desc": "Quorum: AlphaVantage, Polygon, Yahoo, CoinGecko, Binance, Coinbase", "deps": ["cache_ttl", "metrics_provider"]},
    {"id": "cache_ttl", "type": "cache", "desc": "Redis/SQLite TTL cache", "deps": ["db_cache"]},
    {"id": "db_portfolio", "type": "db", "desc": "Portfolio table", "deps": []},
    {"id": "db_predictions", "type": "db", "desc": "Predictions + actuals tables", "deps": []},
    {"id": "db_actuals", "type": "db", "desc": "Actual price history", "deps": []},
    {"id": "db_cache", "type": "db", "desc": "Cache table", "deps": []},
    {"id": "api_news", "type": "api", "desc": "News ingest + sentiment", "deps": ["news_providers", "ai_sentiment"]},
    {"id": "news_providers", "type": "provider", "desc": "News APIs (e.g., AlphaVantage)", "deps": ["cache_ttl"]},
    {"id": "ai_sentiment", "type": "ai", "desc": "Sentiment scoring", "deps": ["ai_provider"]},
    {"id": "api_macro", "type": "api", "desc": "Macro indicators", "deps": ["macro_providers", "ai_macro"]},
    {"id": "macro_providers", "type": "provider", "desc": "Macro data sources", "deps": ["cache_ttl"]},
    {"id": "ai_macro", "type": "ai", "desc": "Macro AI analysis", "deps": ["ai_provider"]},
    {"id": "ai_provider", "type": "provider", "desc": "OpenAI GPT-4o-mini", "deps": []},
    {"id": "telegram_webhook", "type": "api", "desc": "POST /telegram/webhook", "deps": ["telegram_handlers", "api_cockpit"]},
    {"id": "telegram_handlers", "type": "logic", "desc": "Command handlers + Q&A", "deps": ["ai_provider", "telegram_send"]},
    {"id": "telegram_send", "type": "provider", "desc": "Telegram Bot API", "deps": []},
    {"id": "metrics_prometheus", "type": "observability", "desc": "/metrics endpoint", "deps": ["metrics_counters", "metrics_histograms"]},
    {"id": "metrics_counters", "type": "observability", "desc": "Counters: fetches, sends, errors", "deps": []},
    {"id": "metrics_histograms", "type": "observability", "desc": "Histograms: latencies, MAP", "deps": []},
    {"id": "health_ready", "type": "api", "desc": "/health and /ready", "deps": ["db_check", "provider_check"]},
    {"id": "db_check", "type": "logic", "desc": "DB connectivity", "deps": ["db_portfolio", "db_predictions"]},
    {"id": "provider_check", "type": "logic", "desc": "Provider health", "deps": ["price_providers", "news_providers"]},
    {"id": "security_auth", "type": "security", "desc": "Bearer auth + IP allowlist", "deps": []},
    {"id": "feature_flags", "type": "config", "desc": "Env flags: CRYPTO_ENABLED, etc.", "deps": []}
  ],
  "edges": [
    {"from": "ui_cockpit", "to": "api_cockpit", "type": "http"},
    {"from": "ui_prediction_panel", "to": "api_predictions", "type": "http"},
    {"from": "api_cockpit", "to": "db_portfolio", "type": "db"},
    {"from": "api_predictions", "to": "prediction_engine", "type": "logic"},
    {"from": "prediction_engine", "to": "price_providers", "type": "http"},
    {"from": "price_providers", "to": "cache_ttl", "type": "cache"},
    {"from": "cache_ttl", "to": "db_cache", "type": "db"},
    {"from": "api_news", "to": "news_providers", "type": "http"},
    {"from": "api_news", "to": "ai_sentiment", "type": "ai"},
    {"from": "ai_sentiment", "to": "ai_provider", "type": "http"},
    {"from": "api_macro", "to": "macro_providers", "type": "http"},
    {"from": "api_macro", "to": "ai_macro", "type": "ai"},
    {"from": "ai_macro", "to": "ai_provider", "type": "http"},
    {"from": "telegram_webhook", "to": "telegram_handlers", "type": "logic"},
    {"from": "telegram_handlers", "to": "ai_provider", "type": "http"},
    {"from": "telegram_handlers", "to": "telegram_send", "type": "http"},
    {"from": "metrics_prometheus", "to": "metrics_counters", "type": "prometheus"},
    {"from": "metrics_prometheus", "to": "metrics_histograms", "type": "prometheus"},
    {"from": "health_ready", "to": "db_check", "type": "logic"},
    {"from": "health_ready", "to": "provider_check", "type": "logic"},
    {"from": "security_auth", "to": "feature_flags", "type": "config"}
  ],
  "contracts": [
    {"id": "ui_cockpit_loads", "node": "ui_cockpit", "test": "GET /cockpit returns 200 with HTML containing 'Ghost Intelligence'"},
    {"id": "api_cockpit_data", "node": "api_cockpit", "test": "GET /api/cockpit returns JSON with portfolio, predictions, as_of"},
    {"id": "ui_prediction_overlay", "node": "ui_prediction_panel", "test": "UI renders predicted vs actual overlay with confidence ribbon"},
    {"id": "ui_tabs_switch", "node": "ui_tabs", "test": "Stocks|Crypto tabs switch symbol dropdowns"},
    {"id": "api_predictions_stocks", "node": "api_predictions", "test": "GET /api/predict/series?symbol=WOLF returns path array"},
    {"id": "api_predictions_crypto", "node": "api_predictions", "test": "GET /api/crypto/predict/BTC returns forecast_h=48, confidence"},
    {"id": "prediction_mape", "node": "prediction_engine", "test": "Rolling MAP computed and exposed in API"},
    {"id": "price_quorum_stocks", "node": "price_providers", "test": "Median of AlphaVantage, Polygon, Yahoo within 0.5%"},
    {"id": "price_quorum_crypto", "node": "price_providers", "test": "Median of CoinGecko, Binance, Coinbase within 0.5%"},
    {"id": "cache_ttl", "node": "cache_ttl", "test": "Prices cached 5m, predictions 15m"},
    {"id": "db_portfolio", "node": "db_portfolio", "test": "Portfolio table exists with qty, avg_cost"},
    {"id": "db_predictions", "node": "db_predictions", "test": "Predictions tables exist with forecast_points, actual_points"},
    {"id": "api_news_sentiment", "node": "api_news", "test": "News API returns items with sentiment scores"},
    {"id": "ai_sentiment", "node": "ai_sentiment", "test": "Sentiment scoring via OpenAI"},
    {"id": "api_macro", "node": "api_macro", "test": "Macro API returns indicators"},
    {"id": "ai_macro", "node": "ai_macro", "test": "Macro analysis via OpenAI"},
    {"id": "telegram_webhook", "node": "telegram_webhook", "test": "POST /telegram/webhook handles /status command"},
    {"id": "telegram_qa", "node": "telegram_handlers", "test": "Free-form Q&A uses AI and replies"},
    {"id": "telegram_send", "node": "telegram_send", "test": "Messages sent via Bot API"},
    {"id": "metrics_export", "node": "metrics_prometheus", "test": "GET /metrics returns ghost_* series"},
    {"id": "health_ok", "node": "health_ready", "test": "GET /health returns {\"ok\":true}"},
    {"id": "ready_ok", "node": "health_ready", "test": "GET /ready returns 200"},
    {"id": "db_connect", "node": "db_check", "test": "DB queries succeed"},
    {"id": "provider_health", "node": "provider_check", "test": "Providers return valid data"},
    {"id": "auth_bearer", "node": "security_auth", "test": "Bearer token required for writes"},
    {"id": "ip_allowlist", "node": "security_auth", "test": "ADMIN_IP_ALLOWLIST enforced"},
    {"id": "flags_default_safe", "node": "feature_flags", "test": "CRYPTO_ENABLED=0 by default"}
  ]
}
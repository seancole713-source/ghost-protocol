{
  "annotations": {"list": []},
  "panels": [
    {"type": "stat", "title": "Up", "targets": [{"expr": "ghost_up"}]},
    {"type": "gauge", "title": "Snapshot As Of", "targets": [{"expr": "ghost_snapshot_asof"}]},
    {"type": "timeseries", "title": "Snapshot Build p95", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(ghost_cockpit_snapshot_build_seconds_bucket[5m])) by (le))"}]},
    {"type": "timeseries", "title": "Provider latency (avg)", "targets": [{"expr": "sum by (provider)(rate(ghost_provider_fetch_seconds_sum[5m])) / sum by (provider)(rate(ghost_provider_fetch_seconds_count[5m]))"}]},
    {"type": "stat", "title": "Fused Final Score", "targets": [{"expr": "ghost_decision_final_score"}]},
    {"type": "stat", "title": "Why Now Count", "targets": [{"expr": "ghost_why_now_count"}]},
    {"type": "timeseries", "title": "LLM calls rate", "targets": [{"expr": "rate(ghost_llm_calls_total[5m])"}]},
    {"type": "stat", "title": "LLM confidence (last)", "targets": [{"expr": "ghost_llm_confidence"}]}
  ],
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Ghost Complete"
}

{
  "dashboard": {
    "title": "Ghost AI Agent Monitor",
    "tags": ["ghost", "ai", "agent", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "gauge",
        "title": "Current Decision Confidence",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "expr": "ghost_ai_decision_confidence",
            "refId": "A",
            "legendFormat": "Confidence"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "green",
                  "value": 0.7
                }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Time Since Last Decision",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "expr": "(time() - ghost_ai_decision_last_ts) / 60",
            "refId": "A",
            "legendFormat": "Minutes"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "m",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 60
                },
                {
                  "color": "orange",
                  "value": 360
                },
                {
                  "color": "red",
                  "value": 1440
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Tool Success Rate (5m)",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "expr": "rate(ghost_ai_tool_calls_total{result=\"success\"}[5m]) / rate(ghost_ai_tool_calls_total[5m])",
            "refId": "A",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.7
                },
                {
                  "color": "green",
                  "value": 0.9
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Decisions Per Hour",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "expr": "rate(ghost_ai_decisions_total[1h]) * 3600",
            "refId": "A",
            "legendFormat": "Decisions/hr"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 30
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Decision Confidence Over Time",
        "gridPos": {
          "x": 0,
          "y": 6,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "ghost_ai_decision_confidence",
            "refId": "A",
            "legendFormat": "Confidence"
          },
          {
            "expr": "avg_over_time(ghost_ai_decision_confidence[1h])",
            "refId": "B",
            "legendFormat": "1h Average"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "always",
              "pointSize": 5
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Confidence"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "1h Average"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [10, 10],
                    "fill": "dash"
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Decision Rate by Action",
        "gridPos": {
          "x": 12,
          "y": 6,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(ghost_ai_decisions_total{action=\"BUY\"}[5m]) * 3600",
            "refId": "A",
            "legendFormat": "BUY"
          },
          {
            "expr": "rate(ghost_ai_decisions_total{action=\"SELL\"}[5m]) * 3600",
            "refId": "B",
            "legendFormat": "SELL"
          },
          {
            "expr": "rate(ghost_ai_decisions_total{action=\"HOLD\"}[5m]) * 3600",
            "refId": "C",
            "legendFormat": "HOLD"
          },
          {
            "expr": "rate(ghost_ai_decisions_total{action=\"NO_ACTION\"}[5m]) * 3600",
            "refId": "D",
            "legendFormat": "NO_ACTION"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never",
              "stacking": {
                "mode": "normal"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "BUY"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "SELL"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "HOLD"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "yellow"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "NO_ACTION"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "gray"
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        }
      },
      {
        "id": 7,
        "type": "piechart",
        "title": "Action Distribution (24h)",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (action) (increase(ghost_ai_decisions_total[24h]))",
            "refId": "A",
            "legendFormat": "{{action}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "BUY"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "SELL"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "HOLD"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "yellow"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "NO_ACTION"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "gray"
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "pieType": "donut",
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "values": ["value", "percent"]
          },
          "displayLabels": ["percent"]
        }
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "Tool Call Latency (p95)",
        "gridPos": {
          "x": 8,
          "y": 14,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ghost_ai_tool_latency_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "{{tool_name}} p95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(ghost_ai_tool_latency_seconds_bucket[5m]))",
            "refId": "B",
            "legendFormat": "{{tool_name}} p50"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "values": ["min", "max", "mean"]
          }
        }
      },
      {
        "id": 9,
        "type": "table",
        "title": "Tool Call Summary (Last Hour)",
        "gridPos": {
          "x": 16,
          "y": 14,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (tool_name) (increase(ghost_ai_tool_calls_total[1h]))",
            "refId": "A",
            "legendFormat": "{{tool_name}}",
            "instant": true,
            "format": "table"
          },
          {
            "expr": "sum by (tool_name) (increase(ghost_ai_tool_calls_total{result=\"success\"}[1h])) / sum by (tool_name) (increase(ghost_ai_tool_calls_total[1h]))",
            "refId": "B",
            "legendFormat": "{{tool_name}}",
            "instant": true,
            "format": "table"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (tool_name, le) (rate(ghost_ai_tool_latency_seconds_bucket[1h])))",
            "refId": "C",
            "legendFormat": "{{tool_name}}",
            "instant": true,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "renameByName": {
                "tool_name": "Tool",
                "Value #A": "Total Calls",
                "Value #B": "Success Rate",
                "Value #C": "p95 Latency (s)"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "filterable": true
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Success Rate"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percentunit"
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background",
                    "mode": "gradient"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": 0
                      },
                      {
                        "color": "yellow",
                        "value": 0.7
                      },
                      {
                        "color": "green",
                        "value": 0.9
                      }
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "p95 Latency (s)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "s"
                },
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background",
                    "mode": "gradient"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "yellow",
                        "value": 1
                      },
                      {
                        "color": "orange",
                        "value": 3
                      },
                      {
                        "color": "red",
                        "value": 5
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Total Calls",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "Tool Calls by Type (Stacked)",
        "gridPos": {
          "x": 0,
          "y": 22,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(ghost_ai_tool_calls_total[5m]) * 3600",
            "refId": "A",
            "legendFormat": "{{tool_name}} ({{result}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 1,
              "fillOpacity": 50,
              "showPoints": "never",
              "stacking": {
                "mode": "normal"
              }
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "values": ["min", "max", "mean"]
          }
        }
      },
      {
        "id": 11,
        "type": "stat",
        "title": "Agent Health Status",
        "gridPos": {
          "x": 12,
          "y": 22,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "(time() - ghost_ai_decision_last_ts) < 3600",
            "refId": "A",
            "legendFormat": "Recent Activity"
          },
          {
            "expr": "rate(ghost_ai_tool_calls_total{result=\"success\"}[10m]) / rate(ghost_ai_tool_calls_total[10m]) > 0.8",
            "refId": "B",
            "legendFormat": "Tools Healthy"
          },
          {
            "expr": "ghost_ai_decision_confidence > 0.5",
            "refId": "C",
            "legendFormat": "Confidence OK"
          }
        ],
        "transformations": [
          {
            "id": "reduce",
            "options": {
              "reducers": ["last"]
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "❌",
                    "color": "red"
                  },
                  "1": {
                    "text": "✅",
                    "color": "green"
                  }
                }
              }
            ],
            "noValue": "⚠️"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name",
          "orientation": "horizontal"
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "enable": true,
          "expr": "ALERTS{alertname=~\"GhostAgent.*\", severity=\"critical\"}",
          "iconColor": "red",
          "name": "Critical Alerts",
          "tagKeys": "alertname,severity",
          "titleFormat": "{{alertname}}"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "enable": true,
          "expr": "ALERTS{alertname=~\"GhostAgent.*\", severity=\"warning\"}",
          "iconColor": "yellow",
          "name": "Warning Alerts",
          "tagKeys": "alertname,severity",
          "titleFormat": "{{alertname}}"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "selected": false,
            "text": "Prometheus",
            "value": "Prometheus"
          }
        },
        {
          "name": "time_range",
          "type": "custom",
          "query": "1h,6h,24h,7d,30d",
          "current": {
            "selected": false,
            "text": "6h",
            "value": "6h"
          },
          "multi": false
        }
      ]
    }
  }
}

%% GHOST - System Family Tree (Mermaid)
%% Family-tree style hierarchy of the main subsystems

graph TD
  GHOST["GHOST Runtime"]

  %% Top-level branches
  GHOST --> ING["Ingestion"]
  GHOST --> CORE["Core Services"]
  GHOST --> INTG["Integrations & Reporting"]
  GHOST --> API["UI / API Layer (FastAPI)"]
  GHOST --> PERSIST["Persistence"]

  %% Ingestion
  ING --> Prices["Price Providers"]
  Prices --> Yahoo["Yahoo / yfinance"]
  Prices --> Polygon["Polygon.io"]
  Prices --> AlphaV["AlphaVantage"]
  ING --> News["News & Feeds"]
  News --> Reuters["Reuters (RSS / manual)"]
  News --> PolyNews["Polygon News"]
  ING --> Watchlist["Watchlist Scanner"]

  %% Core services
  CORE --> Cache["PRICE_CACHE (TTL open/closed)"]
  CORE --> Guards["Guardrails: Price Anomaly + Corp Action"]
  CORE --> Forecaster["Forecast Engine (48h simple-vol / ensemble)"]
  CORE --> Portfolio["Portfolio & PnL (STATE: qty, avg_cost)"]
  CORE --> Scheduler["Advisor Refresh / Schedulers"]

  %% Integrations (MCP & others)
  INTG --> Telegram["Telegram Alerts"]
  INTG --> MCP["MCP Servers"]
  MCP --> Firecrawl
  MCP --> Memory
  MCP --> DuckDB
  MCP --> HuggingFace
  MCP --> Apify
  MCP --> Logfire
  MCP --> ChromeDevTools["Chrome DevTools"]
  INTG --> GitHub
  INTG --> Notion
  INTG --> Zapier

  %% UI/API
  API --> Cockpit["/api/cockpit (+SSE stream)"]
  API --> ForecastAPI["/forecast/48h/*"]
  API --> PriceDiag["/api/price/diagnostics"]
  API --> WatchAPIs["/api/watchlist/*, /api/top_movers"]
  API --> Health["/health, /metrics"]

  %% Persistence
  PERSIST --> SQLite["SQLite: data/wolf.db"]
  PERSIST --> StateStore["STATE JSON / ghost_state.db"]
  PERSIST --> History["Price ticks, Forecasts, Watchlist"]

  %% Styles
  classDef group fill:#0b132b,stroke:#1c2541,stroke-width:1px,color:#eee;
  classDef leaf fill:#1d3557,stroke:#223,stroke-width:0.5px,color:#eee;
  class GHOST group;
  class ING,CORE,INTG,API,PERSIST group;
  class Prices,News,Watchlist,Cache,Guards,Forecaster,Portfolio,Scheduler,Telegram,MCP,GitHub,Notion,Zapier,Cockpit,ForecastAPI,PriceDiag,WatchAPIs,Health,SQLite,StateStore,History leaf;
        "Alpaca API (broker data)"
      ],
      "solution": {
        "commit": "ce794598fb0b45167bdf6dca4dac887f3640294d",
        "implementation": "with_cap() timeout wrapper",
        "timeout_value": "2.5 seconds",
        "fallback_strategy": "Return safe default values",
        "libraries_used": ["anyio.fail_after", "asyncio.wait_for fallback"]
      },
      "resolution_status": "fixed_deployed_to_github"
    },
    {
      "issue_id": "RC003",
      "problem": "duplicate_route_definitions",
      "root_cause": "FastAPI registers routes in order; last definition wins; duplicate /api/regime/current at lines 11152 and 16499 caused routing confusion and 404s",

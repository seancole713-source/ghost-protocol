# 🎯 GHOST Enhanced News Configuration
# Copy these to your secrets.env file or set as environment variables

# ═══════════════════════════════════════════════════════════════════
# 📰 NEWS FEEDS - TIER 1 (FREE + HIGH SIGNAL)
# ═══════════════════════════════════════════════════════════════════

# Enable Reuters feeds
REUTERS_FEEDS_ON=1

# Reuters RSS Feeds (5 feeds - highest priority)
REUTERS_FEEDS=https://www.reuters.com/business/rss,https://www.reuters.com/markets/rss,https://www.reuters.com/technology/rss,https://www.reuters.com/world/rss,https://www.reuters.com/business/finance/rss

# Additional Premium Feeds via NEWS_MANUAL_FEEDS
NEWS_MANUAL_FEEDS=https://www.marketwatch.com/rss/topstories,https://feeds.marketwatch.com/marketwatch/marketpulse/,https://www.marketwatch.com/rss/realtimeheadlines,https://techcrunch.com/feed/,https://techcrunch.com/category/startups/feed/,https://techcrunch.com/category/artificial-intelligence/feed/,https://www.investors.com/feed/,https://www.investors.com/category/news/technology/feed/,https://www.pymnts.com/feed/

# ═══════════════════════════════════════════════════════════════════
# 🎯 KEYWORD FILTERING (For Watchlist Relevance)
# ═══════════════════════════════════════════════════════════════════

# Track your watchlist symbols (add your stocks here)
REUTERS_SYMBOLS=WOLF,NVDA,PLTR,TSLA,AMD,AAPL,MSFT,GOOGL,META,AMZN

# High-impact keywords (bankruptcy, earnings, FDA, etc.)
REUTERS_KEYWORDS=bankruptcy,chapter 11,restructuring,earnings,beat,miss,upgrade,downgrade,acquisition,merger,fda approval,fda rejection,layoff,delisting,short squeeze,sec investigation,insider trading,fraud,hack,data breach,ipo,spac,tokenization,ai breakthrough,product launch,recall

# ═══════════════════════════════════════════════════════════════════
# ⚙️ NEWS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# News cache TTL (5 minutes = 300 seconds)
NEWS_TTL_S=300

# Only show news from last 4 hours (240 minutes)
NEWS_MAX_AGE_MIN=240

# Trusted news sources (optional whitelist)
NEWS_WHITELIST=reuters.com,marketwatch.com,techcrunch.com,investors.com,pymnts.com,wsj.com,cnbc.com,bloomberg.com

# ═══════════════════════════════════════════════════════════════════
# 🤖 SENTIMENT ANALYSIS (Enable for AI intelligence)
# ═══════════════════════════════════════════════════════════════════

# Enable sentiment scoring (0=off, 1=on)
NEWS_SENTIMENT_ON=1

# Sentiment decay half-life (60 minutes)
NEWS_DECAY_HALF_MIN=60

# Sentiment lookback window (240 minutes = 4 hours)
NEWS_LOOKBACK_MIN=240

# Optional: FinBERT AI model for advanced sentiment (0=rules, 1=AI)
FINBERT_ON=0

# ═══════════════════════════════════════════════════════════════════
# 📊 COMPLETE FEED LIST (14 FREE FEEDS)
# ═══════════════════════════════════════════════════════════════════

